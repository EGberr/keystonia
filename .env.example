# Optional: enables the Claude analyst. Without it the API uses the offline (rule-based) analyst.
ANTHROPIC_API_KEY=

# Backend settings (all optional, defaults shown)
KST_RPC_URL=http://127.0.0.1:8545
KST_MODEL=claude-opus-5-5
KST_EFFORT=medium
KST_DEMO_CONTROLS=true

# Web (web/.env.local)
# BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
